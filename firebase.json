{
  "hosting": {
    "site": "portfoliosol",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map", "size-report.json"],
    "predeploy": ["npm run build:optimized"],
    "postdeploy": ["node scripts/prune-hosting.mjs"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.webp", "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }] },
      { "source": "**/*.m3u8", "headers": [{ "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.ts", "headers": [{ "key": "Content-Type", "value": "video/mp2t" }, { "key": "Cache-Control", "value": "public,max-age=3600" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
