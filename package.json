{
  "name": "portfolio-sol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pregithub": "npm run lint && npm run test:deploy && npm run build:optimized",
    "github": "node scripts/github.mjs",
    "optimize:images": "node scripts/optimize-images.mjs && node scripts/optimize-model.mjs",
    "build:optimized": "npm run optimize:images && vite build && npm run check:size",
    "check:size": "node scripts/check-size.mjs",
    "deploy": "firebase deploy --only hosting --project portfoliosol --non-interactive",
    "test:deploy": "node --test scripts/deployment.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.32.0",
    "matter-js": "^0.20.0",
    "meshline": "^3.3.1",
    "motion": "^13.0.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "15.34.0",
    "globals": "^17.7.0",
    "sharp": "^0.35.5",
    "vite": "^8.2.0"
  }
}
